# Database. Locally: npx prisma dev --name cotizador
# On Neon: DATABASE_URL is the pooled URL (-pooler) and DIRECT_URL the direct one (for migrations).
# Use sslmode=verify-full in both.
DATABASE_URL=
DIRECT_URL=

# Signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The admin account lives in the database (password hashed). Create or change it with:
#   npm run admin:set -- "your@email.com" "your-password"

# Gmail that sends emails to clients from the admin.
# SMTP_PASSWORD is a Google app password (myaccount.google.com/apppasswords), not your normal password.
SMTP_USER=
SMTP_PASSWORD=
